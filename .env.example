# Copy this file to the repository root as .env for local development.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
DATABASE_URL=postgresql://nsa:nsa_local_only@localhost:5432/nsa
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Runtime services use separate least-privilege database credentials.
API_DATABASE_URL=
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_PUBLIC_ORIGIN=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# First-run only: run the bootstrap command once after applying migrations.
# Use a unique email and a password with at least 16 characters.
NSA_SUPER_ADMIN_EMAIL=
NSA_SUPER_ADMIN_PASSWORD=

# Dedicated runtime database roles. Never share credentials between services.
WORKER_DATABASE_URL=
WEB_SESSION_DATABASE_URL=
WEB_SESSION_ENCRYPTION_KEY= # generate with: openssl rand -base64 32
MIGRATOR_DATABASE_URL=

# Agora RTC (the App Certificate must remain server-side).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=900
AGORA_AUDIENCE_TOKEN_ENABLED=false
