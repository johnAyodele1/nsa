NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
DATABASE_URL=postgresql://nsa:nsa_local_only@localhost:5432/nsa
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# DATABASE_URL is for local/CI integration tests only; runtime services use separate credentials.
API_DATABASE_URL=
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_PUBLIC_ORIGIN=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Configure all three OIDC values to enable authenticated report submission.
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=

# Browser OIDC client settings. The client ID is public, never put a client secret here.
NEXT_PUBLIC_OIDC_ISSUER_URL=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=

# Native OIDC public-client configuration (no client secret)
EXPO_PUBLIC_OIDC_ISSUER_URL=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_AUDIENCE=

# Dedicated runtime database roles. API, worker, web session store and migrator must not share credentials.
WORKER_DATABASE_URL=
WEB_SESSION_DATABASE_URL=
WEB_SESSION_ENCRYPTION_KEY= # generate with: openssl rand -base64 32
MIGRATOR_DATABASE_URL=

# Agora RTC (the App Certificate must remain server-side).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=900
AGORA_AUDIENCE_TOKEN_ENABLED=false
